{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "lib": ["ES2020"],
        "types": ["node"],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@kwirthmagnify/kwirth-common": ["../../common/src/index.ts"],
            "@kwirthmagnify/kwirth-common-back": ["../../common-back/src/index.ts"],
            "@kwirthmagnify/kwirth-common-ai": ["../../common-ai/src/index.ts"],
            "@kwirthmagnify/kwirth-common-ai/back": ["../../common-ai/src/back.ts"]
        }
    },
    "include": ["src"]
}
