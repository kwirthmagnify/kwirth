{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kwirth-magnify-t",
  "version": "0.5.122",
  "identifier": "com.github.kwirth",
  "build": {
    "frontendDist": "resources"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kwirth-backend"
    ],
    "resources": [
      "resources/front/**/*"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Kwirth Magnify",
        "url": "splash.html",
        "width": 450,
        "height": 300,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "visible": true
      }
    ]
  }
}
