{
  "name": "@kwirthmagnify/kwirth-common-ai",
  "version": "0.5.44",
  "description": "Shared AI/LLM types and utilities for Kwirth AI plugins",
  "scripts": {
    "build": "del .\\dist\\* /s /q 2>nul & tsc",
    "test": "node --test tests/agent.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./back": {
      "types": "./dist/back.d.ts",
      "require": "./dist/back.js",
      "default": "./dist/back.js"
    },
    "./front": {
      "types": "./dist/front.d.ts",
      "require": "./dist/front.js",
      "default": "./dist/front.js"
    }
  },
  "typesVersions": {
    "*": {
      "back": [
        "dist/back.d.ts"
      ],
      "front": [
        "dist/front.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "author": "Julio Fernandez",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.116",
    "@ai-sdk/deepseek": "^2.0.29",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.53",
    "@openrouter/ai-sdk-provider": "^2.8.0",
    "ai": "^6.0.174",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@kwirthmagnify/kwirth-common": "^0.5.22",
    "@mui/icons-material": "7.1.2",
    "@mui/material": "7.1.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
