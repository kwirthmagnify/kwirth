{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "strict": false,
        "lib": ["ES2020", "DOM"],
        "types": ["node"],
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src"]
}
