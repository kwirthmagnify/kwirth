{
    "id": "magnify",
    "name": "Magnify",
    "displayName": "Magnify",
    "extensionType": "plugin",
    "publisher": "@kwirthmagnify",
    "version": "0.2.0",
    "description": "Magnify channel plugin for Kwirth - a complete Kubernetes management tool: every artifact and event of the cluster, live, and the actions to manage them",
    "icon": "Search",
    "website": "https://kwirthmagnify.dev",
    "requiresRestart": false,
    "requiresExtension": [
        {
            "extensionType": "dce",
            "id": "file-manager",
            "minVersion": "0.1.0"
        },
        {
            "extensionType": "provider",
            "id": "events",
            "minVersion": "0.1.0"
        },
        {
            "extensionType": "provider",
            "id": "metrics",
            "minVersion": "0.1.0"
        }
    ],
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "watch": "node watch.mjs",
        "test": "node tests/run.mjs"
    },
    "dependencies": {
        "@codemirror/commands": "^6.0.0",
        "@codemirror/lang-yaml": "^6.0.0",
        "@codemirror/language": "^6.0.0",
        "@codemirror/search": "^6.0.0",
        "@codemirror/state": "^6.0.0",
        "@codemirror/theme-one-dark": "^6.0.0",
        "@codemirror/view": "^6.0.0",
        "@kwirthmagnify/kwirth-common": "^0.5.71",
        "@kwirthmagnify/kwirth-common-back": "^0.6.7",
        "@kwirthmagnify/kwirth-common-front": "^0.5.66",
        "@uiw/react-codemirror": "^4.25.3",
        "clipboard-copy": "^4.0.1",
        "cron-parser": "^5.4.0",
        "js-yaml": "^4.1.1",
        "lodash": "^4.17.21",
        "react-draggable": "^4.5.0",
        "react-resizable": "^3.1.3",
        "react-use": "^17.6.0",
        "recharts": "^2.13.3",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@jfvilas/react-file-manager": "^1.5.6",
        "@kubernetes/client-node": "^1.4.0",
        "@mui/icons-material": "7.1.2",
        "@mui/material": "7.1.2",
        "@types/express": "^4.17.21",
        "@types/js-yaml": "^4.0.9",
        "@types/lodash": "^4.17.13",
        "@types/node": "^20.12.13",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@types/react-resizable": "^3.0.8",
        "esbuild": "^0.27.2",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "typescript": "^5.4.0"
    }
}
