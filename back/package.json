{
  "name": "kwirth-back",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/copy-docsify.js",
    "build": "tsc && esbuild dist/index.js --bundle --platform=node --target=node24 --outfile=bundle/bundle.js --external:cpu-features --external:better-sqlite3 --external:sqlite3 --external:mysql2 --external:mysql --external:mariadb --external:mariadb/callback --external:tedious --external:oracledb --external:pg-query-stream --external:pg-native",
    "postbuild": "node scripts/build-docs-tgz.js && node -e \"const{cpSync,mkdirSync}=require('fs');cpSync('kwirth-bundled.json','../docker/kwirth-bundled.json');cpSync('../scripts/fetch-bundled.mjs','../docker/fetch-bundled.mjs');mkdirSync('bundle/docsify',{recursive:true});cpSync('docsify','bundle/docsify',{recursive:true});mkdirSync('../docker/bundle/docs',{recursive:true});cpSync('bundle/docs','../docker/bundle/docs',{recursive:true});console.log('Build artefacts copied to docker context and bundle/.');\"",
    "predocs": "node scripts/copy-docsify.js && node scripts/build-docs-tgz.js",
    "prestart": "npm run predocs",
    "prestart:kubernetes": "npm run predocs",
    "prestart:docker": "npm run predocs",
    "prestart:desktop": "npm run predocs",
    "prerun:kubernetes": "npm run predocs",
    "start": "cross-env NODE_OPTIONS=\"--expose-gc --max-old-space-size=2048 --trace-warnings --unhandled-rejections=strict\" nodemon src/index.ts",
    "start:kubernetes": "cross-env NODE_OPTIONS=\"--expose-gc --heapsnapshot-near-heap-limit=1 --max-old-space-size=2048 --trace-warnings --unhandled-rejections=strict\" FORCE=k8s nodemon src/index.ts",
    "run:kubernetes": "cross-env NODE_OPTIONS=\"--expose-gc --heapsnapshot-near-heap-limit=1 --max-old-space-size=2048 --trace-warnings --unhandled-rejections=strict\" FORCE=k8s tsx src/index.ts",
    "start:docker": "cross-env NODE_OPTIONS=\"--expose-gc --max-old-space-size=2048 --trace-warnings --unhandled-rejections=strict\" FORCE=docker nodemon src/index.ts",
    "start:desktop": "cross-env NODE_OPTIONS=\"--expose-gc --max-old-space-size=2048 --trace-warnings --unhandled-rejections=strict\" FORCE=desktop AUTH=kubeconfig nodemon src/index.ts",
    "test": "node tests/run.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@jfvilas/parse-listing": "^1.0.1",
    "@kubernetes/client-node": "^1.4.0",
    "@kwirthmagnify/kwirth-common": "^0.5.32",
    "@kwirthmagnify/kwirth-common-ai": "^0.5.30",
    "@kwirthmagnify/kwirth-common-back": "^0.5.25",
    "@kwirthmagnify/kwirth-common-sql": "^0.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.12.13",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dockerode": "^4.0.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.2",
    "http-proxy-middleware": "^3.0.5",
    "request-ip": "^3.3.0",
    "tar": "^6.2.1",
    "ts-semaphore": "^1.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.37",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/node-fetch": "^2.6.11",
    "@types/tar": "^6.1.13",
    "@types/ws": "^8.5.10",
    "cross-env": "^10.1.0",
    "docsify": "^4.13.1",
    "docsify-copy-code": "^3.0.0",
    "docsify-sidebar-collapse": "^1.2.0",
    "esbuild": "^0.27.2",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
