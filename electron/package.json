{
	"name": "kwirth-magnify",
	"author": {
		"name": "Julio Fernandez",
		"email": "jfvilas@outlook.com",
		"url": "https://github.com/jfvilas"
	},
	"main": "main.js",
	"version": "0.5.139",
	"description": "Kwirth Magnify Desktop",
	"homepage": "https://kwirthmagnify.dev",
	"scripts": {
		"start": "electron .",
		"fetch-plugins": "node ../scripts/fetch-bundled-plugins.mjs ../back/kwirth-bundled-plugins.json bundled-plugins",
		"predist": "node ../scripts/fetch-bundled-plugins.mjs ../back/kwirth-bundled-plugins.json bundled-plugins",
		"dist": "electron-builder",
		"dist:win": "electron-builder --win",
		"dist:linux": "electron-builder --linux",
		"dist:mac": "electron-builder --mac"
	},
	"build": {
		"appId": "com.github.kwirth",
		"productName": "kwirth-magnify-0.5.139-e",
		"files": [
			"./main.js",
			"./preload.js",
			"./splash.html",
			"./kwirth-transparent.png",
			"./version.js",
			"./bundle/**/*",
			"./bundled-plugins/**/*"
		],
		"asar": false,
		"directories": {
			"output": "dist"
		},
		"nsis": {
			"artifactName": "${productName}-installer.${ext}"
		},
		"portable": {
			"artifactName": "${productName}.${ext}"
		},
		"win": {
			"icon": "kwirth-transparent.ico",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				}
			]
		},
		"linux": {
			"icon": "kwirth-transparent.png",
			"artifactName": "${productName}.${ext}",
			"target": [
				"AppImage"
			],
			"category": "Utility",
			"executableArgs": [
				"--no-sandbox"
			]
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.utilities"
		}
	},
	"dependencies": {
		"portfinder": "^1.0.38"
	},
	"devDependencies": {
		"concurrently": "^9.2.1",
		"electron": "^40.1.0",
		"electron-builder": "^26.4.0",
		"wait-on": "^9.0.3"
	}
}